# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used for local development
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore lock files
.terraform.lock.hcl

# Ignore environment-specific variable files
environments/*/terraform.tfvars

# Ignore local development files
.env
.envrc
.direnv

# Ignore IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# Ignore OS specific files
.DS_Store
Thumbs.db

# Ignore log files
*.log

# Ignore temporary files
*.tmp
*.bak

# Ignore test coverage reports
coverage/

# Ignore generated documentation
docs/generated/